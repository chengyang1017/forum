// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(uuid()) @db.Uuid
  firebaseUid String @unique @db.VarChar(128)

  username String  @unique @db.VarChar(50)
  email    String? @unique @db.VarChar(320)

  nickname  String? @db.VarChar(100)
  avatarUrl String? @db.Text
  bio       String? @db.Text

  birthday DateTime?
  showAge  Boolean   @default(true)

  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags         UserTag[]
  languages    UserLanguage[]
  posts        Post[]
  postVersions PostVersion[]  @relation("PostVersionAuthor")
  postLikes PostLike[]

  @@map("users")
}

model UserTag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  value     String   @db.VarChar(50)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, value])
  @@index([value])
  @@map("user_tags")
}

model UserLanguage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  languageCode String   @db.VarChar(32)
  scriptCode   String   @default("") @db.VarChar(32)
  level        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode, scriptCode])
  @@index([languageCode])
  @@map("user_languages")
}

model Post {
  id String @id @default(uuid()) @db.Uuid

  // 迁移期间保留旧 Firestore posts/{docId}
  // 等 likes/comments 等全部迁走后再考虑删除。
  firestoreId String? @unique @db.VarChar(128)

  authorId String? @db.Uuid

  category            String? @db.VarChar(100)
  primaryLanguageCode String  @db.VarChar(32)

  likeCount    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  versions PostVersion[]
  images   PostImage[]
  likes PostLike[]

  @@index([authorId])
  @@index([category, createdAt])
  @@index([primaryLanguageCode, createdAt])
  @@map("posts")
}

model PostVersion {
  id String @id @default(uuid()) @db.Uuid

  postId       String  @db.Uuid
  authorId     String? @db.Uuid
  languageCode String  @db.VarChar(32)

  title   String @default("") @db.Text
  content String @default("") @db.Text

  bodyDelta Json

  // original / manual / ai / ai_assisted
  type String @default("original") @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation("PostVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([postId, languageCode])
  @@index([languageCode])
  @@index([authorId])
  @@map("post_versions")
}

model PostImage {
  id String @id @default(uuid()) @db.Uuid

  postId String @db.Uuid

  url      String @db.Text
  position Int

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@index([postId])
  @@map("post_images")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}
